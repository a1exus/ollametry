    },
    {
      "id": 17,
      "type": "table",
      "title": "Loaded models",
      "description": "From /api/ps. Keep-alive is the time left before an idle model is unloaded; blank when it is kept loaded forever.",
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 24,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "format": "table",
          "expr": "max by (ollama_model_name, ollama_model_family, ollama_model_parameter_size, ollama_model_quantization, ollama_model_runner) (ollama_model_memory_size_bytes and (time() - timestamp(ollama_model_memory_size_bytes) < 45))"
        },
        {
          "refId": "B",
          "instant": true,
          "format": "table",
          "expr": "max by (ollama_model_name) (ollama_model_memory_vram_size_bytes and (time() - timestamp(ollama_model_memory_vram_size_bytes) < 45))"
        },
        {
          "refId": "C",
          "instant": true,
          "format": "table",
          "expr": "max by (ollama_model_name) (ollama_model_context_length and (time() - timestamp(ollama_model_context_length) < 45))"
        },
        {
          "refId": "D",
          "instant": true,
          "format": "table",
          "expr": "max by (ollama_model_name) (ollama_model_keep_alive_remaining_seconds and (time() - timestamp(ollama_model_keep_alive_remaining_seconds) < 45))"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "ollama_model_name",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "Time 4": true
            },
            "indexByName": {
              "ollama_model_name": 0,
              "ollama_model_family": 1,
              "ollama_model_parameter_size": 2,
              "ollama_model_quantization": 3,
              "ollama_model_runner": 4,
              "Value #A": 5,
              "Value #B": 6,
              "Value #C": 7,
              "Value #D": 8
            },
            "renameByName": {
              "ollama_model_name": "Model",
              "ollama_model_family": "Family",
              "ollama_model_parameter_size": "Parameters",
              "ollama_model_quantization": "Quantization",
              "ollama_model_runner": "Runner",
              "Value #A": "Memory",
              "Value #B": "GPU memory",
              "Value #C": "Context",
              "Value #D": "Unloads in"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No models loaded",
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Memory"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "GPU memory"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Context"
            },
            "properties": [
              {
                "id": "unit",
                "value": "suffix: tokens"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Unloads in"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Memory",
            "desc": true
          }
        ]
      }
    },
